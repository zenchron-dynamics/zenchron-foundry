# =============================================================================
# config/base-images.env -- Approved base image inventory (SINGLE SOURCE OF TRUTH)
# =============================================================================
#
# This file is the single source of truth for every upstream base image that
# the production Docker image matrix is allowed to build FROM. Each logical
# family records the human-readable upstream tag, the immutable content digest
# (@sha256:...), and the architectures the digest is verified to provide.
#
# This platform is Debian-first (bookworm). The ONLY non-Debian exception is
# Caddy (Alpine), documented below, because no official upstream Debian Caddy
# image exists.
#
# Format:
#   - The file is shell-sourceable: `set -a; . config/base-images.env; set +a`
#   - Keys are UPPER_SNAKE_CASE. Per family we expose:
#       <FAMILY>_REF      human-readable upstream reference (tag, no digest)
#       <FAMILY>_DIGEST   immutable digest (sha256:...)
#       <FAMILY>_VERSION  fully-pinned reference (REF@DIGEST) used by Dockerfiles
#       <FAMILY>_ARCHES   space-separated platform list expected to resolve
#   - LAST_VERIFIED marks the date the digests + arch lists were last confirmed.
#
# HOW TO UPDATE (do not hand-edit digests blindly):
#   1. Pick the new upstream tag (keep it Debian/bookworm unless noted).
#   2. Resolve the multi-arch digest:
#        docker buildx imagetools inspect <ref>
#      Copy the top-level (manifest list) digest, NOT a per-arch digest.
#   3. Update <FAMILY>_DIGEST and <FAMILY>_VERSION here.
#   4. Update the matching `ARG *_BASE=` line in the relevant Dockerfile(s)
#      under images/ so they reference the exact same REF@DIGEST.
#   5. Bump LAST_VERIFIED to today's date.
#   6. Run scripts/verify-base-images.sh -- it cross-checks this file against
#      both the live registry (amd64 + arm64 must exist) and the Dockerfiles.
#
# The php-worker family intentionally has no digest of its own: the worker
# images FROM the php-cli base, so they reuse the php-cli 8.3 / 8.4 digests.
# =============================================================================

LAST_VERIFIED=2026-07-24

# -----------------------------------------------------------------------------
# php-cli 8.3 -- Debian bookworm
# -----------------------------------------------------------------------------
PHP_CLI_83_REF="php:8.3-cli-bookworm"
PHP_CLI_83_DIGEST="sha256:a4fcf31ffb94b8d19b84514926b5a2cddf22a38b1e29922f8d3e8a933091f806"
PHP_CLI_83_VERSION="php:8.3-cli-bookworm@sha256:a4fcf31ffb94b8d19b84514926b5a2cddf22a38b1e29922f8d3e8a933091f806"
PHP_CLI_83_ARCHES="linux/amd64 linux/arm64"

