# -----------------------------------------------------------------------------
# caddy -- ALPINE EXCEPTION (documented).
# There is no official upstream Debian Caddy image, so this family is the sole
# permitted non-Debian base. Alpine ships multi-arch, so amd64 + arm64 must
# both still resolve and are enforced by scripts/verify-base-images.sh.
# -----------------------------------------------------------------------------
CADDY_REF="caddy:2-alpine"
CADDY_DIGEST="sha256:77c07d5ebfa5be9fd6c820d2094ae662c9e7eeb9bf98346b7f639900263ee2a2"
