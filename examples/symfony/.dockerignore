# Zenchron Dynamics — secure build context for Symfony app images.
# Prevents `COPY . .` from leaking secrets / bloat into the image.

# --- secrets / credentials (NEVER in an image) ---
# All .env* files stay out of the image: runtime config/secrets are injected as
# real environment variables (compose `environment:`, orchestrator secrets).
.env*
*.pem
*.p12
*.key
*.crt
config/secrets/*/*.decrypt.private.php
auth.json

# --- VCS / CI ---
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml

# --- dependencies rebuilt in the builder stage ---
node_modules
vendor

# --- runtime / writable state (externalized at runtime) ---
var/cache/*
var/log/*
var/sessions/*

# --- local tooling / editors ---
.idea
.vscode
.DS_Store
*.log

# --- tests / docs / compose (not needed in the runtime image) ---
tests
phpunit.xml.dist
docker-compose*.yml
compose*.yml
Dockerfile
.dockerignore
README.md
