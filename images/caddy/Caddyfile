# =============================================================================
# Zenchron Dynamics — Caddy production base config.
# Global options + import of site snippets from conf.d/. No project domains.
# =============================================================================
{
	admin off            # disable admin API (attack surface)
	# CERTIFIED TOPOLOGY: this image MUST NOT terminate TLS. auto_https off stops
	# Caddy creating any TLS listener or certificate automation, so a malformed
	# TLS SNI can never reach certmagic -> idna.Lookup.ToASCII -> x/text
	# unicode/norm (CVE-2026-56852, norm.Iter infinite loop, fixed in x/text
	# v0.39.0 which the vendored v0.37.0 predates). TLS terminates at the
	# upstream load balancer. See docs/security/triage-2026-07-28-ungoverned-findings.md.
	auto_https off
	storage file_system /data/caddy
	log {
		output stderr
		format json
		level INFO
	}
}

# Reusable PRIVACY-MINIMISED ACCESS LOG, imported by sites (#107).
#
# Caddy writes no access log unless a site asks for one, so this is opt-IN by
# Caddy's design rather than ours. What we can control is what the opt-in
# produces: importing `privacy_log` gives a log with no query string, no
# credential headers and a truncated client address.
#
# All of it is Caddy's own `format filter` — `query`, `delete` and `ip_mask` are
# built in. No hand-rolled hashing and no invented cryptography: IPv4 keeps the
# /24 and IPv6 the /48, which is enough to see traffic shape and rate-limit
# patterns and not enough to single out a subscriber.
(privacy_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The query string is where tokens and reset codes live. Caddy's
				# `query` filter only acts on NAMED parameters, which would mean
				# maintaining a list of every credential name an application might
				# invent. `regexp` strips everything from the first `?` instead —
				# name-independent, so a parameter nobody anticipated is still not
				# logged. The path survives.
				request>uri regexp "\?.*$" ""
				# Credentials, not diagnostics. There is no operational case for
				# writing these to disk, so they are dropped rather than hashed.
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>Cookie delete
				request>headers>X-Api-Key delete
				request>headers>X-Auth-Token delete
				resp_headers>Set-Cookie delete
				# Referer carries the previous URL, including its query string.
				request>headers>Referer delete
				# BOTH, deliberately. Caddy logs `remote_ip` (the peer) AND
				# `client_ip` (the peer, or the trusted-proxy-resolved originator).
				# Masking only remote_ip left the full address in client_ip — found
				# by the canary run, not by reading the config.
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}

# Reusable hardened-headers snippet, imported by sites.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}
}

# Deny access to sensitive files. Import inside a site block.
(deny_hidden) {
	@hidden path /.env /.git/* /.* /composer.json /composer.lock /*.bak /*.sql
	respond @hidden 404
}

# Always-on readiness endpoint on a dedicated internal port. Proves Caddy is
# actually accepting and answering HTTP (readiness), independent of any app site
# mounted under conf.d/. The container HEALTHCHECK probes http://127.0.0.1:8081/healthz.
:8081 {
	respond /healthz "ok" 200
	respond * 404
}

import /etc/caddy/conf.d/*.caddy
