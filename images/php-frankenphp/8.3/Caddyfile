# =============================================================================
# Zenchron Dynamics — FrankenPHP production Caddyfile (template)
# Non-root: listen on :8080 (HTTP) + :8081 (healthz). TLS is normally terminated
# at an upstream LB/ingress; enable Caddy auto-TLS only if this process is
# internet-facing AND has NET_BIND_SERVICE. No project domains baked in.
# =============================================================================
{
	# Run the embedded server; admin API off by default (attack surface).
	admin off
	# auto_https off  # uncomment when TLS terminates upstream
	frankenphp {
		# worker mode (optional, high-throughput): one resident app instance.
		# worker /app/public/index.php
	}
	# Persisted state under writable XDG dirs (tmpfs/volume on read-only rootfs).
	storage file_system /tmp/caddy-data
}

:8080 {
	root * /app/public

	encode zstd gzip

	# Security headers (aligned with the caddy image's security_headers snippet).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}

	# Deny dotfiles and sensitive paths.
	@forbidden path /.* /vendor/* /storage/* /.env /.git/*
	respond @forbidden 404

	# Serve PHP through the embedded runtime.
	php_server

	log {
		output stderr
		format json
		level INFO
	}
}

# Always-on readiness endpoint on a dedicated internal port. Proves the embedded
# server accepts and answers HTTP (readiness) without depending on app code being
# present. The container HEALTHCHECK probes http://127.0.0.1:8081/healthz.
:8081 {
	respond /healthz "ok" 200
	respond * 404
}
