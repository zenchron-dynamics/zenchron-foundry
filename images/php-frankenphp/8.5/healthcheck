#!/bin/sh
# Zenchron Dynamics — FrankenPHP readiness healthcheck.
# Debian-based hardened image ships no curl/wget. Probe the always-on /healthz
# site on the internal readiness port with the bundled php binary: a 200 proves
# the embedded server is serving HTTP (readiness), not just that the binary runs.
# Exit 0 = healthy.
exec php -r '
$f = @fsockopen("127.0.0.1", 8081, $e, $s, 2);
if (!$f) { exit(1); }
fwrite($f, "GET /healthz HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n");
$r = stream_get_contents($f);
fclose($f);
exit(strpos($r, " 200 ") !== false ? 0 : 1);
'
