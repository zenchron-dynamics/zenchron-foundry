#!/bin/sh
# =============================================================================
# Zenchron Dynamics — php-worker entrypoint (liveness heartbeat + signals)
# Runs the worker command, maintains a heartbeat file, and forwards signals so
# the worker shuts down gracefully. tini is PID 1 (set in the Dockerfile) and
# wraps this script.
#
# Heartbeat semantics (BE HONEST about what this proves):
#   WORKER_HEARTBEAT_AUTO=1 (default) -> this script refreshes the heartbeat
#       while the worker PROCESS is alive. That is PROCESS-liveness only; it does
#       NOT detect a deadlocked-but-alive worker.
#   WORKER_HEARTBEAT_AUTO=0 -> this script writes ONE initial heartbeat and then
#       leaves refreshing to the application (true WORK-liveness): the app must
#       `touch`/write $WORKER_HEARTBEAT_FILE each successful job loop.
# The companion worker-healthcheck checks the file's freshness either way.
#
# Works under a read-only root filesystem: the heartbeat lives in tmpfs /tmp.
# Does not require curl/wget. Does not alter the worker command.
# =============================================================================
set -u

HB="${WORKER_HEARTBEAT_FILE:-/tmp/worker-heartbeat}"
AUTO="${WORKER_HEARTBEAT_AUTO:-1}"
INTERVAL="${WORKER_HEARTBEAT_INTERVAL:-15}"

heartbeat() { date +%s > "$HB" 2>/dev/null || true; }

if [ "$#" -eq 0 ]; then
    echo "worker-entrypoint: no worker command supplied" >&2
    exit 64
fi

heartbeat   # initial beat so the start-period healthcheck can pass

# Start the worker in the background so we can trap signals and reap it.
"$@" &
child=$!

ticker=""
if [ "$AUTO" = "1" ]; then
    ( while kill -0 "$child" 2>/dev/null; do heartbeat; sleep "$INTERVAL"; done ) &
    ticker=$!
fi

# Forward termination signals to the worker for graceful shutdown.
forward() { kill -"$1" "$child" 2>/dev/null || true; }
trap 'forward TERM' TERM
trap 'forward INT'  INT
trap 'forward QUIT' QUIT
trap 'forward HUP'  HUP

# Wait for the worker, surviving `wait` being interrupted by a trapped signal.
code=0
while kill -0 "$child" 2>/dev/null; do
    wait "$child"
    code=$?
done

[ -n "$ticker" ] && kill "$ticker" 2>/dev/null || true
exit "$code"
