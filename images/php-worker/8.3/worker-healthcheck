#!/bin/sh
# =============================================================================
# Zenchron Dynamics — php-worker healthcheck.
# Healthy iff the heartbeat file exists and was updated within MAX_AGE seconds.
# No curl/wget. Pairs with worker-entrypoint (see its header for the honest
# process- vs work-liveness distinction).
#   WORKER_HEARTBEAT_FILE    default /tmp/worker-heartbeat
#   WORKER_HEARTBEAT_MAX_AGE default 90 (seconds)
# Exit 0 = healthy, 1 = stale/missing (unhealthy).
# =============================================================================
set -u

HB="${WORKER_HEARTBEAT_FILE:-/tmp/worker-heartbeat}"
MAX="${WORKER_HEARTBEAT_MAX_AGE:-90}"

[ -f "$HB" ] || { echo "no heartbeat at $HB" >&2; exit 1; }

# Read the epoch WRITTEN INTO the file (not the file mtime): a frozen worker
# stops writing, so the stored timestamp ages out even if something else touches
# the file. worker-entrypoint and app-level heartbeats both write `date +%s`.
now=$(date +%s)
mod=$(cat "$HB" 2>/dev/null || echo 0)
case "$mod" in ''|*[!0-9]*) mod=0 ;; esac
age=$(( now - mod ))

if [ "$age" -le "$MAX" ]; then
    exit 0
fi
echo "heartbeat stale: ${age}s > ${MAX}s" >&2
exit 1
