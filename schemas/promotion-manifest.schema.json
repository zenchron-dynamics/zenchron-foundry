{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.dev/schemas/promotion-manifest.schema.json",
  "title": "Zenchron Foundry stable-promotion result manifest",
  "description": "Written in promotion Phase 3 after every alias is verified to resolve to the exact RC digest. Evidence that stable == RC, per alias.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "candidate", "revision", "created_at", "aliases"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" },
    "candidate": { "type": "string", "pattern": "^rc[1-9][0-9]*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "digest", "verified"],
        "properties": {
          "ref": { "type": "string", "pattern": "^ghcr\\.io/[^/]+/[^:@]+:[^@]+$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}
