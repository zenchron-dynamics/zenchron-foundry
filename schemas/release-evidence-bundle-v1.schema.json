{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.dev/schemas/release-evidence-bundle-v1.schema.json",
  "title": "Release evidence bundle manifest, version 1",
  "description": "The manifest of a self-contained release evidence bundle (#128). Everything an auditor needs to reconstruct a release decision AFTER the producing workflow's artifacts have expired: authorized child digests and platforms, the source revision and build inputs, the frozen scanner and vulnerability-database identity, SBOM digests, findings and their reconciliation, the machine-readable dispositions (VEX) and the exception policy digest they were derived from, smoke and metadata results, provenance, the authorization record, the evidence class, checksums and retention metadata. Verification is offline: no registry, no GitHub, no network.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_type",
    "bundle_id",
    "evidence_class",
    "source_revision",
    "generated_at",
    "generator",
    "acceptance",
    "scanner",
    "vulnerability_database",
    "matrix",
    "children",
    "execution_disclosure",
    "sbom",
    "findings",
    "reconciliation",
    "dispositions",
    "policy_digests",
    "provenance",
    "authorization",
    "retention",
    "checksums",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_type": {
      "const": "release-evidence-bundle"
    },
    "bundle_id": {
      "type": "string",
      "description": "Deterministic identity of this bundle: <evidence_class>-<short source revision>-<run id>. Two generator runs over the same inputs produce the same bundle_id.",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "evidence_class": {
      "description": "The artifact/evidence class this bundle carries, from policies/evidence-classes.yaml. Consumed, never redefined here.",
      "enum": [
        "upstream-base",
        "foundry-child",
        "staged-candidate",
        "published-artifact"
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The one Foundry revision every child in this bundle was built from. Abbreviated revisions are refused: two commits can share a prefix."
    },
    "release": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Set only once a bundle has been promoted to a release. Null on a candidate bundle \u2014 a candidate has no release version and inventing one is exactly how a candidate gets read as a release.",
      "required": [
        "version",
        "candidate"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^rc[1-9][0-9]*$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC3339 UTC. Derived from the source acceptance record, NOT from the generator's wall clock, so the bundle is byte-reproducible."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "schema"
      ],
      "properties": {
        "script": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "description": "The acceptance run this bundle is the durable record of. These are the identifiers that let a reader find the run while it still exists, and stop needing it once it does not.",
      "required": [
        "verdict",
        "workflow",
        "workflow_run_id",
        "workflow_run_attempt",
        "workflow_ref",
        "source_record_sha256"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "workflow": {
          "type": "string"
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_ref": {
          "type": "string"
        },
        "run_url": {
          "type": "string"
        },
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the exact bytes of the acceptance record this bundle was generated from. The bundle is a derivation; this pins what it was derived from."
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "digest_pinned"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest_pinned": {
          "const": true
        }
      }
    },
    "vulnerability_database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "frozen"
      ],
      "description": "ONE database identity for the whole bundle. Two identities across a matrix means two different questions were asked and the answers cannot be compared.",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "const": true
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_definitions",
        "platforms",
        "expected_children",
        "observed_children"
      ],
      "properties": {
        "image_definitions": {
          "type": "integer",
          "minimum": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^linux/[a-z0-9]+$"
          }
        },
        "expected_children": {
          "type": "integer",
          "minimum": 1
        },
        "observed_children": {
          "type": "integer",
          "minimum": 1
        },
        "platform_split": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "child_key",
          "child_slug",
          "image_family",
          "image_version",
          "image_label",
          "platform",
          "manifest_digest",
          "execution_mode",
          "source_revision",
          "evidence_sha256",
          "package_inventory",
          "severity_counts",
          "gates",
          "evidence_file"
        ],
        "properties": {
          "child_key": {
            "type": "string",
            "description": "child_key() from scripts/lib/common.sh. The ONE identity derivation in this repository."
          },
          "child_slug": {
            "type": "string",
            "description": "child_slug() from scripts/lib/common.sh."
          },
          "image_family": {
            "type": "string"
          },
          "image_version": {
            "type": "string"
          },
          "image_label": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "pattern": "^linux/[a-z0-9]+$"
          },
          "manifest_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "digest_reference": {
            "type": "string"
          },
          "config_architecture": {
            "type": "string"
          },
          "staging_tag": {
            "type": "string"
          },
          "execution_mode": {
            "enum": [
              "native",
              "qemu"
            ],
            "description": "How the child was BUILT AND EXERCISED. QEMU-emulated arm64 is not native arm64 runtime evidence (#111) and the release seal refuses to let it be presented as such."
          },
          "host_architecture": {
            "type": "string"
          },
          "runner_name": {
            "type": "string"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The per-child evidence checksum already produced by the acceptance pipeline (scripts/release/evidence-checksum.sh). Carried through, never recomputed with a second algorithm."
          },
          "package_inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_count",
              "sha256"
            ],
            "properties": {
              "package_count": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "severity_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "smoke_test",
              "metadata_contract",
              "scan",
              "reconciliation"
            ],
            "properties": {
              "smoke_test": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "metadata_contract": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "scan": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "reconciliation": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "sbom": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "description": "This child's SBOM of record. Null ONLY when no --sbom-dir was supplied: an absent SBOM is recorded as absent, never as an empty one, and the release seal (R7) refuses a bundle with any null child SBOM. The file is named by sbom_filename() in scripts/lib/common.sh \u2014 the same function scripts/generate-sbom.sh calls to write it \u2014 and its subject_digest is re-read from the document itself, so an SBOM for another digest cannot substitute by being filed under this child's name.",
            "required": [
              "format",
              "sha256",
              "file",
              "subject_digest"
            ],
            "properties": {
              "format": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "file": {
                "type": "string"
              },
              "subject_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The digest the SBOM document itself claims to describe, read from documentDescribes / metadata.component. Must equal this child's manifest_digest."
              },
              "companions": {
                "type": "array",
                "description": "Additional declared-format documents for the SAME child, each bound to the same subject. A companion never substitutes for the format of record.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "format",
                    "sha256",
                    "file"
                  ],
                  "properties": {
                    "format": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "file": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "evidence_file": {
            "type": "string",
            "description": "Path, relative to the bundle root, of this child's full evidence extract."
          }
        }
      }
    },
    "execution_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_children",
        "qemu_children",
        "statement"
      ],
      "description": "Explicit, because the difference between 'ran on arm64 hardware' and 'ran on an x86 host under emulation' is the difference between runtime evidence and a build artifact.",
      "properties": {
        "native_children": {
          "type": "integer",
          "minimum": 0
        },
        "qemu_children": {
          "type": "integer",
          "minimum": 0
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "native_platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emulated_platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "complete",
        "children_with_sbom",
        "children_total"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "children_with_sbom": {
          "type": "integer",
          "minimum": 0
        },
        "children_total": {
          "type": "integer",
          "minimum": 1
        },
        "index_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "complete": {
          "type": "boolean",
          "description": "Every child in this bundle carries an SBOM of record whose subject is that child's manifest digest. A bundle with `present: true` and `complete: false` is refused by verify: a partial bill of materials reads as a complete one to every consumer that only checks `present`."
        },
        "identity_function": {
          "type": [
            "string",
            "null"
          ],
          "description": "The ONE derivation producer and consumer both call for an SBOM filename. Recorded so a future divergence is visible in the record rather than only in the two implementations."
        }
      },
      "description": "The bill of materials this bundle carries. `present` alone was never the fact a release decision needs: it said only that SOME child had a document, and it read `false` over a complete SBOM directory whenever the producer's filenames and the consumer's lookup disagreed. `complete` is the binding fact \u2014 every child, one SBOM of record, each bound to that child's manifest digest."
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity_totals",
        "distinct_advisories",
        "observed_tuples"
      ],
      "properties": {
        "severity_totals": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "distinct_advisories": {
          "type": "integer",
          "minimum": 0
        },
        "observed_tuples": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct (child digest, advisory, package, version) tuples. This is the exact universe a VEX statement may speak about; anything wider is a claim without evidence."
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "children_reconciled",
        "children_total",
        "ungoverned_findings",
        "policy_file",
        "policy_sha256"
      ],
      "properties": {
        "children_reconciled": {
          "type": "integer",
          "minimum": 0
        },
        "children_total": {
          "type": "integer",
          "minimum": 1
        },
        "ungoverned_findings": {
          "type": "integer",
          "minimum": 0
        },
        "policy_file": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "format",
        "statement_count",
        "exception_policy_sha256"
      ],
      "description": "The machine-readable vulnerability dispositions (#115) generated for this bundle, and the digest of the exception/not_affected policy they were derived from. A disposition set that outlives its policy digest is a claim nobody can re-derive.",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "type": "string"
        },
        "statement_count": {
          "type": "integer",
          "minimum": 0
        },
        "exception_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "earliest_exception_expiry": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy_digests": {
      "type": "object",
      "description": "sha256 of every policy file whose content decided this bundle's verdict, keyed by repo-relative path. Reconstructing the decision means reading these exact bytes, not today's.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision",
        "workflow_ref",
        "workflow_run_id",
        "staging_package"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_ref": {
          "type": "string"
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "staging_package": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "public_exposure_authorized",
        "verdict",
        "generated_at",
        "record_file"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "public_exposure_authorized": {
          "type": "boolean",
          "description": "Whether this authorization covers making the artifacts publicly reachable. It is a SEPARATE decision from build acceptance; the release seal refuses a public release without it."
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "build_created": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_file": {
          "type": "string"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_file",
        "policy_sha256",
        "evidence_class",
        "retention_days",
        "retain_until",
        "immutable_storage_required"
      ],
      "properties": {
        "policy_file": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_class": {
          "type": "string"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "retain_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "immutable_storage_required": {
          "type": "boolean"
        },
        "minimum_independent_locations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "content_checksum",
        "content_checksum_tool",
        "sums_file",
        "aggregate_file"
      ],
      "description": "content_checksum is produced by scripts/release/evidence-checksum.sh \u2014 the SAME path-independent function the acceptance pipeline already uses for per-child evidence, so a bundle relocated between machines still verifies.",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "content_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_checksum_tool": {
          "type": "string"
        },
        "sums_file": {
          "type": "string"
        },
        "aggregate_file": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Every file this bundle contains, relative to the bundle root, EXCEPT the checksum files themselves. Verification refuses any file present on disk but absent here: a file outside checksum coverage is a file anybody can add later.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/][^\\x00]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  }
}
