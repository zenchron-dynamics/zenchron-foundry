{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.dev/schemas/release-manifest.schema.json",
  "title": "Zenchron Foundry RC release manifest",
  "description": "Authoritative, signed source of truth for stable promotion. Exactly the ten matrix images, each pinned to an immutable digest and bound to one source revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release", "candidate", "revision",
    "source_repository", "source_ref", "workflow_run_id", "created_at", "images"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" },
    "candidate": { "type": "string", "pattern": "^rc[1-9][0-9]*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "source_ref": { "type": "string", "minLength": 1 },
    "workflow_name": { "type": "string" },
    "workflow_run_id": { "type": "string", "pattern": "^[0-9]+$" },
    "workflow_run_attempt": { "type": "string", "pattern": "^[0-9]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "images": {
      "type": "object",
      "minProperties": 14,
      "maxProperties": 14,
      "additionalProperties": false,
      "patternProperties": {
        "^(php-(cli|fpm|worker|frankenphp)-8\\.[345]|nginx|caddy)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "immutable_tag", "digest", "reference", "revision", "platforms"],
          "properties": {
            "repository": { "type": "string", "pattern": "^ghcr\\.io/[^/]+/[^/:@]+$" },
            "immutable_tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "reference": { "type": "string", "pattern": "^ghcr\\.io/[^/]+/[^@]+@sha256:[0-9a-f]{64}$" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "platforms": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 2,
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "linux/amd64" } },
                { "contains": { "const": "linux/arm64" } }
              ]
            }
          }
        }
      }
    }
  }
}
