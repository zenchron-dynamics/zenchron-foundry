{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenchron.dev/schemas/repository-material-v1.schema.json",
  "title": "foundry.repository-material/v1",
  "description": "The canonical inventory of third-party material that lives in the REPOSITORY rather than inside a built image. Image SBOMs cannot see this material by construction, so nothing derived from an SBOM may be read as evidence about it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "baseline",
    "materials",
    "dispositions"
  ],
  "properties": {
    "schema": {
      "const": "foundry.repository-material/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tracked_issue": {
      "type": [
        "integer",
        "null"
      ]
    },
    "baseline": {
      "type": "object",
      "description": "The explicit REVIEWED BASELINE. Discovery is heuristic and cannot prove that an arbitrary file was not copied from somewhere; the baseline is the non-heuristic half. Material outside it is unreviewed, and unreviewed is a refusal, not a pass.",
      "additionalProperties": false,
      "required": [
        "path_list",
        "path_list_sha256",
        "path_count",
        "observed_at_revision",
        "reviewed_at_revision",
        "reviewed_by",
        "reviewed_on",
        "reviewed_count",
        "unreviewed_count",
        "generated_audit_count"
      ],
      "properties": {
        "path_list": {
          "type": "string"
        },
        "path_list_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path_count": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_at_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The last revision whose declared review scope was ACTUALLY reviewed. It describes the reviewed COHORT, not the whole path list. It must never be advanced to cover paths recorded as unreviewed or generated-audit."
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_method": {
          "type": "string",
          "minLength": 1
        },
        "observed_at_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The revision the PATH LIST was generated from. Distinct from reviewed_at_revision on purpose: generating the list is not reviewing it, and a machine-checkable list is not a review claim."
        },
        "reviewed_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Paths in the reviewed cohort. reviewed + unreviewed + generated_audit MUST equal path_count."
        },
        "unreviewed_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Paths present in the list that nobody has reviewed. Recorded, never implied."
        },
        "generated_audit_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Deterministic machine output with a recorded producer. NOT a licence claim and NOT an exemption: generated evidence can itself carry copied material."
        },
        "unreviewed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every path in the unreviewed cohort, enumerated. A count with no list is a claim nobody can check."
        },
        "generated_audit_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every path in the generated-audit cohort, enumerated, classified by PROVENANCE AND CONTENT CLASS rather than by directory. docs/audits/ is not blanket-exempt: three MIT excerpts already live under it."
        },
        "cohort_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/material"
      }
    },
    "dispositions": {
      "type": "array",
      "description": "Tracked files that TRIP a discovery signal but are NOT incorporated third-party material. Each needs a named reason and a reviewer. This is not an exception list for the gate \u2014 the gate still refuses anything that appears in neither array.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification",
          "reason",
          "reviewed_by",
          "reviewed_on"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "first-party",
              "scanner-self-reference",
              "quotation-not-incorporation",
              "generated-evidence-capture"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 40
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  },
  "definitions": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "material_identity",
        "upstream",
        "acquisition",
        "local_modifications",
        "licence",
        "obligations",
        "hashes",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "material_identity": {
          "type": "string",
          "minLength": 10
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "source_url",
            "revision",
            "path"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "acquired_on",
            "recorded_by"
          ],
          "properties": {
            "method": {
              "enum": [
                "verbatim-copy",
                "derived-work",
                "excerpt",
                "generated-from-upstream",
                "patch",
                "transformed"
              ]
            },
            "acquired_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "local_modifications": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modified",
            "changes"
          ],
          "properties": {
            "modified": {
              "type": "boolean"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_spdx",
            "determination"
          ],
          "properties": {
            "declared_spdx": {
              "type": [
                "string",
                "null"
              ]
            },
            "determination": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "obligations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_license_text",
            "required_notice",
            "copyright_attribution",
            "source_offer",
            "reciprocity"
          ],
          "properties": {
            "required_license_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "required_notice": {
              "type": [
                "string",
                "null"
              ]
            },
            "local_notice": {
              "type": [
                "string",
                "null"
              ]
            },
            "copyright_attribution": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_offer": {
              "enum": [
                "not-applicable",
                "required-unsatisfied",
                "satisfied"
              ]
            },
            "reciprocity": {
              "enum": [
                "none",
                "file-level",
                "weak-copyleft",
                "strong-copyleft",
                "network-copyleft"
              ]
            }
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_content_sha256",
            "upstream_content_sha256"
          ],
          "properties": {
            "repository_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "upstream_content_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "tracked_issue"
          ],
          "properties": {
            "status": {
              "enum": [
                "reviewed",
                "unreviewed",
                "superseded"
              ]
            },
            "reviewed_by": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "tracked_issue": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
