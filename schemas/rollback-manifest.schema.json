{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.dev/schemas/rollback-manifest.schema.json",
  "title": "Zenchron Foundry stable-promotion rollback manifest",
  "description": "Captured in promotion Phase 1 BEFORE any alias is mutated: the prior digest of every alias the promotion will change, so a compensating rollback can restore exactly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "candidate", "revision", "created_at", "aliases"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" },
    "candidate": { "type": "string", "pattern": "^rc[1-9][0-9]*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "prior_digest"],
        "properties": {
          "ref": { "type": "string", "pattern": "^ghcr\\.io/[^/]+/[^:@]+:[^@]+$" },
          "prior_digest": {
            "description": "Prior digest, or NONE for an alias that does not yet exist (new).",
            "type": "string",
            "pattern": "^(sha256:[0-9a-f]{64}|NONE)$"
          }
        }
      }
    }
  }
}
