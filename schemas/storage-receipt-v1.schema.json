{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.dev/schemas/storage-receipt-v1.schema.json",
  "title": "foundry.storage-receipt/v1",
  "description": "PROOF that one evidence bundle reached durable storage under a stated retention guarantee, returned by the storage authority and consumed by the canonical authorization. It is deliberately PROVIDER-NEUTRAL: it names a provider but constrains none, because the provider decision is the owner's (#241) and a schema that presumed one would be that decision made by an engineer. A CLAIMED upload is not a receipt \u2014 every field below is something the authority observed after the write, not something Foundry asked for.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_type",
    "schema_version",
    "bundle",
    "request",
    "storage",
    "readback"
  ],
  "properties": {
    "schema": {
      "const": "foundry.storage-receipt/v1"
    },
    "record_type": {
      "const": "storage-receipt"
    },
    "schema_version": {
      "const": 1
    },
    "bundle": {
      "description": "WHAT Foundry handed over, identified so that a receipt for another candidate cannot be presented for this one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "evidence_class",
        "retention_class",
        "source_revision",
        "authorization_record_sha256",
        "manifest_sha256",
        "candidate",
        "producers",
        "schemas",
        "files"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 8
        },
        "evidence_class": {
          "enum": [
            "upstream-base",
            "foundry-child",
            "staged-candidate",
            "published-artifact"
          ]
        },
        "retention_class": {
          "enum": [
            "upstream-base",
            "foundry-child",
            "staged-candidate",
            "published-artifact"
          ]
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authorization_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "children_expected",
            "children"
          ],
          "properties": {
            "children_expected": {
              "type": "integer",
              "minimum": 1
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "child_key",
                  "platform",
                  "manifest_digest"
                ],
                "properties": {
                  "child_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 3
                  },
                  "manifest_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "producers": {
          "description": "Who wrote the bytes, identified by their own content hash. A bundle whose producer cannot be named is a bundle whose contents cannot be reproduced or challenged.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "description": "Every ORIGINAL byte handed over, by path and sha256. Not a summary: the readback below is verified against this list file by file.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "description": "Present for a class retained for a release's supported lifetime. Its absence is refused as SR-RELEASE-BINDING-ABSENT, because evidence cannot track a lifecycle it does not identify.",
          "required": [
            "release",
            "supported_until"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "supported_until": {
              "type": "string",
              "format": "date-time",
              "description": "The support end for the LINE this release belongs to. The retain-until floor is this plus the deprecation and withdrawal notice buffers, so it is per-release and not a constant."
            },
            "support_state": {
              "type": "string"
            }
          }
        },
        "published_evidence": {
          "type": "object",
          "additionalProperties": false,
          "description": "The evidence a PUBLISHED release's retention is about. It must be COPIED, PROMOTED OR COMPOSED INTO this bundle \u2014 not pointed at. A published bundle that merely references a 90-day transport artifact inherits that artifact's lifetime, so the bundle would be incomplete long before the support commitment it justifies ends. `scan_verdicts` and `authorization_record_sha256` must appear in `bundle.files`, which is what makes 'carried' checkable rather than asserted. The image digests are references BY DESIGN: the registry is the durable identity and the bytes are regenerable from it.",
          "required": [
            "image_digests",
            "scan_verdicts",
            "authorization_record_sha256",
            "scanner",
            "vulnerability_database",
            "source_revision",
            "policy_identity",
            "ledger_identity"
          ],
          "properties": {
            "image_digests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "scan_verdicts": {
              "type": "array",
              "minItems": 1,
              "description": "One per child, carried as bytes. Each sha256 must appear in bundle.files.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "child_key",
                  "sha256"
                ],
                "properties": {
                  "child_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "authorization_record_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scanner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "image",
                "digest"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "vulnerability_database": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "observed_at"
              ],
              "description": "Identity and observation time only. The BYTES are deliberately not retained; see policies/retention.yaml vulnerability_database.",
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "source_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "policy_identity": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "licence_policy_sha256",
                "retention_policy_sha256"
              ],
              "properties": {
                "licence_policy_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "retention_policy_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "ledger_identity": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "vulnerability_exceptions_sha256"
              ],
              "properties": {
                "vulnerability_exceptions_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "transient_references": {
              "type": "array",
              "description": "Any evidence this bundle POINTS AT rather than carries, together with when that thing expires. A non-empty list on a published class is refused: a bundle is only as durable as the shortest thing it depends on.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "expires_at"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "kind": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "request": {
      "description": "What Foundry REQUIRED, stated before the write so the receipt can be checked against it rather than against whatever came back.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_retain_until",
        "required_lock_mode",
        "required_versioning",
        "required_min_retention_days"
      ],
      "properties": {
        "required_retain_until": {
          "type": "string",
          "format": "date-time"
        },
        "required_lock_mode": {
          "description": "What the class's retention model requires. `none` is the CORRECT value for repository-artifact and supported-release-lifetime: a GitHub artifact and a release asset offer no lock, and a receipt that requested one would record a demand this repository knows cannot be met. This enum carried only compliance|governance until 2026-08-30, which made a truthful receipt for the mechanism actually in use inexpressible.",
          "enum": [
            "compliance",
            "governance",
            "none"
          ]
        },
        "required_versioning": {
          "description": "Whether the class's model requires object versioning. Was `const: true` \u2014 an unconditional demand inherited from the withdrawn seven-year rule. Only regulated-worm requires it.",
          "type": "boolean"
        },
        "required_min_retention_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "storage": {
      "description": "What the AUTHORITY observed after the write. Provider and region are recorded, never constrained. The WORM-specific properties \u2014 compliance lock mode, enabled versioning, encryption at rest \u2014 are MANDATORY ONLY for a class whose retention model is regulated-worm. Requiring them of ordinary evidence would refuse the mechanisms actually in use (a GitHub artifact and a release asset offer none of them), which is how a policy ends up describing a system nobody runs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "region",
        "container",
        "object_key",
        "retain_until",
        "uploaded_at",
        "object_checksum",
        "audit_event_id",
        "version_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2
        },
        "region": {
          "type": "string",
          "minLength": 2
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "description": "Empty means the authority reported no version at all, which the verifier refuses as SR-AUTHORITY-UNAVAILABLE. Without versioning an overwrite is indistinguishable from the original, so a receipt with no version identity proves nothing about immutability."
        },
        "retain_until": {
          "type": "string",
          "format": "date-time"
        },
        "lock_mode": {
          "enum": [
            "compliance",
            "governance",
            "none"
          ],
          "description": "compliance = no principal, including the account root, can shorten or delete before retain_until. governance = a privileged principal CAN bypass. none = no lock, which is CORRECT and expected for repository-artifact and supported-release-lifetime classes. `governance` is a retention control and is NOT immutability; calling it immutable is the misstatement this enum exists to prevent."
        },
        "versioning": {
          "enum": [
            "enabled",
            "suspended",
            "disabled",
            "not-applicable"
          ],
          "description": "not-applicable is legitimate for a mechanism that has no versioning, such as a GitHub release asset. The verifier requires `enabled` only for a regulated-worm class."
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_rest",
            "algorithm"
          ],
          "properties": {
            "at_rest": {
              "type": "boolean"
            },
            "algorithm": {
              "type": "string",
              "minLength": 2
            },
            "key_management": {
              "enum": [
                "provider-managed",
                "customer-managed",
                "customer-supplied"
              ]
            },
            "key_id": {
              "type": "string"
            },
            "key_deletion_protection": {
              "type": "boolean"
            }
          }
        },
        "object_checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time"
        },
        "audit_event_id": {
          "type": "string",
          "description": "Empty means the write was never recorded by an audit trail, which the verifier refuses as SR-AUTHORITY-UNAVAILABLE."
        }
      }
    },
    "readback": {
      "description": "The write was READ BACK and verified. An upload that was never read back is a claim; this is the observation that turns it into evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "at",
        "files_expected",
        "files_verified",
        "checksum_match",
        "manifest_sha256"
      ],
      "properties": {
        "performed": {
          "type": "boolean",
          "description": "false is a VALID receipt shape and an INVALID receipt: the verifier refuses it as SR-READBACK-ABSENT, because an upload that was never read back is a claim about durability rather than a measurement of it. Constraining it to true here would make that refusal unreachable and replace a named diagnostic with a schema error."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "files_expected": {
          "type": "integer",
          "minimum": 1
        },
        "files_verified": {
          "type": "integer",
          "minimum": 0
        },
        "checksum_match": {
          "type": "boolean"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "network_isolated": {
          "type": "boolean"
        }
      }
    }
  }
}
