#!/usr/bin/env bash
# Fallback pre-commit hook for environments without the `pre-commit` framework.
# Activate: git config core.hooksPath scripts/git-hooks
# Prefer the full framework (scripts/install-hooks.sh) when available.
set -euo pipefail

fail=0

# Block large files (>512KB).
while IFS= read -r f; do
    [ -f "$f" ] || continue
    size=$(wc -c <"$f")
    if [ "$size" -gt 524288 ]; then echo "Large file blocked (>512KB): $f"; fail=1; fi
done < <(git diff --cached --name-only)

# Secret scan if gitleaks is present.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --config policies/gitleaks.toml || fail=1
fi

# Dockerfile lint if hadolint is present.
if command -v hadolint >/dev/null 2>&1; then
    # --diff-filter=d: a DELETED Dockerfile still appears in --name-only, and
    # handing it to hadolint crashes the hook with an uncaught Haskell
    # IOException ("withBinaryFile: does not exist"). That set fail=1, so a
    # commit that REMOVES a Dockerfile could not be made at all. Found while
    # withdrawing the PHP 8.5 images. Belt and braces: also skip anything that
    # is no longer on disk.
    while IFS= read -r f; do
        case "$f" in
          */Dockerfile)
            [ -f "$f" ] || continue
            hadolint --config policies/hadolint.yaml "$f" || fail=1
            ;;
        esac
    done < <(git diff --cached --name-only --diff-filter=d)
fi

exit "$fail"
